# Server
NODE_ENV=development
PORT=4000
APP_NAME=2Bee
CORS_ORIGINS=*

# Database: 'pglite' locally (zero setup) or 'postgres' (Supabase / Neon Free Tier)
DB_MODE=pglite
PGLITE_DATA_DIR=./.pglite
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/twobee_dev?schema=public

# Redis GEO & Zone A->B matching (Upstash Free Redis or automatic in-memory fallback when empty)
REDIS_URL=
GEO_BACKEND=auto
H3_RESOLUTION=8

# Auth & Compliance
JWT_ACCESS_SECRET=twobee_dev_access_secret_min_32_characters_long_key
JWT_REFRESH_SECRET=twobee_dev_refresh_secret_min_32_characters_long_key
JWT_ROLE_SECRET=twobee_dev_role_secret_min_32_characters_long_key
ROLE_INACTIVITY_MINUTES=15
PAYOUT_CHANGE_HOLD_HOURS=48

# SMS / OTP: 'mock' (or Firebase Phone Auth via /auth/firebase-phone-login) | 'sslwireless' | 'greenweb' | 'twilio'
SMS_PROVIDER=mock
DEV_STATIC_OTP=123456
SSLWIRELESS_API_TOKEN=
SSLWIRELESS_SID=2BEE
GREENWEB_API_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Payments: COD + Online (Stripe Free Sandbox); MFS kept UI preview until prod keys
PAYMENT_MODE=stripe_sandbox
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
BDT_TO_USD_RATE=0.0084
MFS_LIVE_ENABLED=false

# Maps & Storage: 'osm' (100% Free) | 'barikoi' | 'google'; Storage: 'local' | 'r2' | 's3'
MAPS_PROVIDER=osm
OSRM_BASE_URL=https://router.project-osrm.org
BARIKOI_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads
SIGNED_URL_SECRET=twobee_dev_signed_secret_change_in_prod
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=2bee-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Firebase (Auth + Push Notifications on Free Spark Plan)
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Admin API & Dashboard Credentials
ADMIN_SEED_EMAIL=admin@2bee.app
ADMIN_SEED_PASSWORD=Admin@2BeeDev!
ADMIN_EMAILS=admin@2bee.app
