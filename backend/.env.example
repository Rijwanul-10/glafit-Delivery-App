# Server
NODE_ENV=development
PORT=4000
APP_NAME=2Bee
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000

# Database: use embedded PGlite locally when DB_MODE=pglite, or real PostgreSQL URL when DB_MODE=postgres
DB_MODE=pglite
PGLITE_DATA_DIR=./.pglite
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/twobee_dev?schema=public

# Redis GEO & Zone A->B matching: connects to REDIS_URL if provided, with automatic in-memory fallback when empty/unreachable
REDIS_URL=
GEO_BACKEND=auto
# H3 hyper-scale bucket resolution (planned drop-in hook inside GeoMatchService, e.g. res 8 ~ 0.7km)
H3_RESOLUTION=8

# Auth & Compliance
JWT_ACCESS_SECRET=twobee_dev_access_secret_min_32_characters_long_key
JWT_REFRESH_SECRET=twobee_dev_refresh_secret_min_32_characters_long_key
JWT_ROLE_SECRET=twobee_dev_role_secret_min_32_characters_long_key
ROLE_INACTIVITY_MINUTES=15
PAYOUT_CHANGE_HOLD_HOURS=48

# Free SMS / OTP
SMS_PROVIDER=mock
DEV_STATIC_OTP=123456

# Payments: COD + Online (Stripe Sandbox); bKash/Nagad/Rocket kept UI-only until live credentials
PAYMENT_MODE=stripe_sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
BDT_TO_USD_RATE=0.0084
MFS_LIVE_ENABLED=false

# Free Maps & Storage
MAPS_PROVIDER=osm
OSRM_BASE_URL=https://router.project-osrm.org
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads
SIGNED_URL_SECRET=twobee_dev_signed_secret_change_in_prod

# Push (optional in local dev)
FCM_ENABLED=false

# Admin API seed credentials (Admin UI planned Phase 3)
ADMIN_SEED_EMAIL=admin@2bee.app
ADMIN_SEED_PASSWORD=Admin@2BeeDev!

